WITH scan_data AS (
    SELECT
        fas.asset_id,
        ds.scan_id,
        ds.finished,
        DATE(ds.finished) AS scan_day
    FROM fact_asset_scan fas
    JOIN dim_scan ds ON fas.scan_id = ds.scan_id
    JOIN dim_scan_status dss ON ds.status_id = dss.status_id
    WHERE dss.description = 'Successful'
      AND ds.finished > NOW() - INTERVAL '30 days'   -- compliance window
)
SELECT
    da.host_name AS asset_name,
    da.ip_address,
    COUNT(DISTINCT sd.scan_id) AS scans_completed,
    COUNT(DISTINCT sd.scan_day) AS days_with_scan,
    30 AS days_in_period,
    MIN(sd.finished) AS first_scan_date,
    MAX(sd.finished) AS last_scan_date,
    ROUND(COUNT(DISTINCT sd.scan_day) * 100.0 / 30, 1) AS daily_coverage_pct,
    ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(sd.finished))) / 86400) AS days_since_last_scan,
    CASE
        WHEN COUNT(DISTINCT sd.scan_id) = 0 THEN 'NON-COMPLIANT - Never scanned'
        WHEN COUNT(DISTINCT sd.scan_day) >= 30 THEN 'COMPLIANT - Daily'
        WHEN COUNT(DISTINCT sd.scan_day) >= 27 THEN 'MOSTLY COMPLIANT (90%+)'
        ELSE 'NON-COMPLIANT'
    END AS compliance_status,
    string_agg(DISTINCT to_char(sd.scan_day, 'YYYY-MM-DD'), ', '
               ORDER BY to_char(sd.scan_day, 'YYYY-MM-DD') DESC) AS all_scan_dates
FROM dim_asset da
LEFT JOIN scan_data sd ON da.asset_id = sd.asset_id
GROUP BY da.asset_id, da.host_name, da.ip_address
ORDER BY days_with_scan ASC, asset_name;
