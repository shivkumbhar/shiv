WITH scan_data AS (
    SELECT
        fas.asset_id,
        ds.scan_id,
        ds.finished,
        -- which fortnight bucket this scan falls into (0 = most recent 14 days, 1 = the one before)
        FLOOR(EXTRACT(EPOCH FROM (NOW() - ds.finished)) / 86400 / 14) AS fortnight_bucket
    FROM fact_asset_scan fas
    JOIN dim_scan ds ON fas.scan_id = ds.scan_id
    JOIN dim_scan_status dss ON ds.status_id = dss.status_id
    WHERE dss.description = 'Successful'
      AND ds.finished > NOW() - INTERVAL '28 days'   -- 2 full fortnights
)
SELECT
    da.host_name AS asset_name,
    da.ip_address,
    COUNT(DISTINCT sd.scan_id) AS scans_completed,
    2 AS scans_required,                                            -- 1 per fortnight x 2 fortnights
    COUNT(DISTINCT sd.fortnight_bucket) AS fortnights_covered,
    to_char(MIN(sd.finished), 'YYYY-MM-DD HH24:MI') AS first_scan_date,
    to_char(MAX(sd.finished), 'YYYY-MM-DD HH24:MI') AS last_scan_date,
    ROUND(EXTRACT(EPOCH FROM (NOW() - MAX(sd.finished))) / 86400) AS days_since_last_scan,
    ROUND(COUNT(DISTINCT sd.fortnight_bucket) * 100.0 / 2, 1) AS compliance_pct,
    CASE
        WHEN COUNT(DISTINCT sd.scan_id) = 0 THEN 'NON-COMPLIANT - Never scanned'
        WHEN COUNT(DISTINCT sd.fortnight_bucket) >= 2 THEN 'COMPLIANT - Fortnightly'
        WHEN COUNT(DISTINCT sd.fortnight_bucket) = 1 THEN 'PARTIAL - 1 of 2 fortnights'
        ELSE 'NON-COMPLIANT'
    END AS compliance_status
FROM dim_asset da
LEFT JOIN scan_data sd ON da.asset_id = sd.asset_id
GROUP BY da.asset_id, da.host_name, da.ip_address
ORDER BY compliance_pct ASC, asset_name;

